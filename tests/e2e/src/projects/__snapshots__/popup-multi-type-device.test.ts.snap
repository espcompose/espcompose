          espcompose::sig_ovrl_ref34_mux.set(closure.__ctrl_instance_index);
          espcompose::flush(); lv_obj_clear_flag(id(ovrl_ref34),
          LV_OBJ_FLAG_HIDDEN); lv_obj_move_foreground(id(ovrl_ref34));"
      - script.execute:
          id: scr_ref54
          closure_index: 0
      - script.wait:
          id: scr_ref54
  - id: scr_ref56
    parameters:
      closure_index: int
    then:
      - script.execute:
          id: scr_ref55
          closure_index: 0
      - script.wait:
          id: scr_ref55
      - lambda: !lambda "lv_obj_add_flag(id(ovrl_ref34), LV_OBJ_FLAG_HIDDEN);"
"
`;
