script:
  - id: scr_ref31
    mode: restart
    parameters:
      closure_index: int
      msg: string
    then:
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref31_closures[closure_index]; (void)closure;
          espcompose::sig_global_g_ref16.set(msg); espcompose::flush();"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref31_closures[closure_index]; (void)closure;
          espcompose::sig_global_g_ref28.get_mut()[0] = 1;
          espcompose::sig_global_g_ref28.notify(); espcompose::flush();"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref31_closures[closure_index]; (void)closure;
          espcompose::sig_global_g_ref29.get_mut()[0] = id(g_ref30);
          espcompose::sig_global_g_ref29.notify(); espcompose::flush();"
      - globals.set:
          id: g_ref30
          value: !lambda "auto& closure =
            espcompose::scr_ref31_closures[closure_index]; (void)closure;
            return id(g_ref30) + 1;"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref31_closures[closure_index]; (void)closure;
          espcompose::sig_ovrl_ref13_mux.set(closure.__ctrl_instance_index);
          espcompose::flush(); lv_obj_clear_flag(id(ovrl_ref13),
          LV_OBJ_FLAG_HIDDEN); lv_obj_move_foreground(id(ovrl_ref13));"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref31_closures[closure_index]; (void)closure;
          lv_anim_start(&espcompose::anim_4bcf5b74);"
      - delay: 3s
