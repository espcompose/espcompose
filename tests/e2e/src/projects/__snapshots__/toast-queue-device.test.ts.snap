          espcompose::scr_ref31_closures[closure_index]; (void)closure;
          espcompose::sig_global_g_ref28.get_mut()[0] = 0;
          espcompose::sig_global_g_ref28.notify(); espcompose::flush();"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref31_closures[closure_index]; (void)closure;
          lv_obj_add_flag(id(ovrl_ref13), LV_OBJ_FLAG_HIDDEN);"
      - if:
          condition:
            - lambda: !lambda "auto& closure =
                espcompose::scr_ref31_closures[closure_index]; (void)closure;
                return id(g_ref28)[0] == 0;"
          then:
            - globals.set:
                id: g_ref30
                value: !lambda "auto& closure =
                  espcompose::scr_ref31_closures[closure_index];
                  (void)closure; return 0;"
  - id: scr_ref32
