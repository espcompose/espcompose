exports[`toast-params > toast-params > espcompose_reactive.h 1`] = `
"// espcompose_reactive.h — SolidJS-style fine-grained reactive runtime
//
// Dependency tracking is automatic: reading a Signal/Memo inside a tracked
// execution context (Memo::update or Effect::update) registers the reader
// as a subscriber. No explicit wiring is needed.
#pragma once

#include <functional>
#include <cstdint>
#include <limits>

#include "esphome/core/component.h"
#include "esphome/core/hal.h"

// Define ESPCOMPOSE_LOG to enable debug logging (requires esphome/core/log.h).
// Example: add -DESPCOMPOSE_LOG to build_flags in platformio_options.
#ifdef ESPCOMPOSE_LOG
#include "esphome/core/log.h"
static const char *const ESPCOMPOSE_TAG = "espcompose";
#define ESPCOMPOSE_LOGD(fmt, ...) ESP_LOGD(ESPCOMPOSE_TAG, fmt, ##__VA_ARGS__)
#define ESPCOMPOSE_LOGW(fmt, ...) ESP_LOGW(ESPCOMPOSE_TAG, fmt, ##__VA_ARGS__)
#else
#define ESPCOMPOSE_LOGD(...)
#define ESPCOMPOSE_LOGW(...)
#endif

// Define ESPCOMPOSE_PERF to enable performance timing instrumentation.
// Example: add -DESPCOMPOSE_PERF to build_flags (done automatically by --perf).
#ifdef ESPCOMPOSE_PERF
#include "esphome/core/log.h"
static const char *const ESPCOMPOSE_PERF_TAG = "ec_perf";
#define ESPCOMPOSE_PERF_BEGIN() uint32_t _perf_start_us = esphome::micros()
#define ESPCOMPOSE_PERF_END(label, fmt, ...) \\
  ESP_LOGI(ESPCOMPOSE_PERF_TAG, label " took %" PRIu32 " \\xC2\\xB5s" fmt, esphome::micros() - _perf_start_us, ##__VA_ARGS__)
#else
#define ESPCOMPOSE_PERF_BEGIN()
#define ESPCOMPOSE_PERF_END(label, ...)
#endif

namespace espcompose {

// ── Forward declarations ────────────────────────────────────────────────────

class Scheduler;
class NodeBase;

// ── Subscriber overflow storage ─────────────────────────────────────────────
// Each SubscribableBase embeds 4 inline subscriber slots. If a node accumulates
// more than 4 subscribers, overflow blocks are allocated from a global bump
// allocator. Blocks and the allocator are never freed at runtime.

static constexpr uint8_t INLINE_SUB_CAP = 4;
static constexpr uint8_t OVERFLOW_BLOCK_CAP = 4;

struct SubscriberBlock {
  NodeBase* subs[OVERFLOW_BLOCK_CAP]{};
  SubscriberBlock* next{nullptr};
};

struct SubscriberBlockAllocator {
  static constexpr uint16_t SLAB_SIZE = 32;

  SubscriberBlock* allocate() {
    if (offset_ >= slab_count_) {
      grow();
    }
    return &slab_[offset_++];
  }

private:
  void grow() {
    auto* prev = slab_;
    slab_ = new SubscriberBlock[SLAB_SIZE];
    slab_count_ = SLAB_SIZE;
    offset_ = 0;
    (void)prev; // intentionally leaked — never freed at runtime
  }

  SubscriberBlock* slab_{nullptr};
  uint16_t slab_count_{0};
  uint16_t offset_{0};
};

inline SubscriberBlockAllocator& sub_block_allocator() {
  static SubscriberBlockAllocator alloc;
  return alloc;
}

// ── SubscribableBase ────────────────────────────────────────────────────────
// Pure subscriber storage with no vtable, dirty flag, or scheduling overhead.
// Signals inherit from this directly. Memos and Effects get it via NodeBase.

class SubscribableBase {
public:
  uint16_t subscriber_count() const { return subscriber_count_; }

  void add_subscriber(NodeBase* sub) {
    // Dedup: linear scan (subscriber lists are small and append-only)
    for (uint16_t i = 0; i < subscriber_count_; ++i) {
      if (sub_at(i) == sub) return;
    }

    if (subscriber_count_ < INLINE_SUB_CAP) {
      inline_subs_[subscriber_count_++] = sub;
      return;
    }

    // Overflow: find or allocate a block with space
    uint16_t overflow_idx = subscriber_count_ - INLINE_SUB_CAP;
    uint16_t block_idx = overflow_idx / OVERFLOW_BLOCK_CAP;
    uint16_t slot_idx = overflow_idx % OVERFLOW_BLOCK_CAP;

    SubscriberBlock* block;
    if (slot_idx == 0) {
      // Need a new block
      auto* new_block = sub_block_allocator().allocate();
      new_block->next = nullptr;
      if (!overflow_) {
        overflow_ = new_block;
      } else {
        // Walk to tail
        SubscriberBlock* tail = overflow_;
        while (tail->next) tail = tail->next;
        tail->next = new_block;
      }
      block = new_block;
    } else {
      // Walk to the correct block
      block = overflow_;
      for (uint16_t b = 0; b < block_idx; ++b) {
        block = block->next;
      }
    }
    block->subs[slot_idx] = sub;
    ++subscriber_count_;
  }

  // Iterate all subscribers and call a callable on each
  template <typename F>
  void for_each_subscriber(F&& fn) const {
    uint16_t remaining = subscriber_count_;
    // Inline slots
    uint16_t inline_count = remaining < INLINE_SUB_CAP ? remaining : INLINE_SUB_CAP;
    for (uint16_t i = 0; i < inline_count; ++i) {
      fn(inline_subs_[i]);
    }
    remaining -= inline_count;
    // Overflow blocks
    const SubscriberBlock* block = overflow_;
    while (remaining > 0 && block) {
      uint16_t count = remaining < OVERFLOW_BLOCK_CAP ? remaining : OVERFLOW_BLOCK_CAP;
      for (uint16_t i = 0; i < count; ++i) {
        fn(block->subs[i]);
      }
      remaining -= count;
      block = block->next;
    }
  }

protected:
  ~SubscribableBase() = default;

private:
  NodeBase* sub_at(uint16_t idx) const {
    if (idx < INLINE_SUB_CAP) return inline_subs_[idx];
    uint16_t overflow_idx = idx - INLINE_SUB_CAP;
    const SubscriberBlock* block = overflow_;
    while (overflow_idx >= OVERFLOW_BLOCK_CAP) {
      block = block->next;
      overflow_idx -= OVERFLOW_BLOCK_CAP;
    }
    return block->subs[overflow_idx];
  }

  uint16_t subscriber_count_{0};
  NodeBase* inline_subs_[INLINE_SUB_CAP]{};
  SubscriberBlock* overflow_{nullptr};
};

// ── NodeBase ────────────────────────────────────────────────────────────────

class NodeBase : public SubscribableBase {
public:
  virtual ~NodeBase() = default;

  void mark_dirty();
  virtual void update() {}

  bool is_dirty() const { return dirty_; }
  void set_dirty(bool d) { dirty_ = d; }

private:
  bool dirty_{false};
};

// ── Scheduler (slab-allocated blue/green lists) ─────────────────────────────

struct ScheduleSlab {
  NodeBase** items;
  uint16_t capacity;
  ScheduleSlab* next;
};

struct SlabList {
  ScheduleSlab* head{nullptr};
  ScheduleSlab* tail{nullptr};
  uint16_t tail_count{0};
  uint16_t total{0};

  void append(NodeBase* node) {
    if (!tail || tail_count >= tail->capacity) {
      grow();
    }
    tail->items[tail_count++] = node;
    ++total;
  }

  void clear() {
    tail = head;
    tail_count = 0;
    total = 0;
  }

  // Collect all items into a contiguous buffer.
  // Caller provides buffer with at least \`total\` capacity.
  void collect_into(NodeBase** buf) const {
    uint16_t offset = 0;
    const ScheduleSlab* slab = head;
    while (slab && offset < total) {
      uint16_t count = (slab == tail) ? tail_count : slab->capacity;
      for (uint16_t i = 0; i < count && offset < total; ++i) {
        buf[offset++] = slab->items[i];
      }
      slab = slab->next;
    }
  }

private:
  static constexpr uint16_t INITIAL_CAP = 64;
  static constexpr uint16_t GROW_CAP = 32;

  void grow() {
    // Reuse existing next slab if available (from a previous flush cycle)
    if (tail && tail_count >= tail->capacity && tail->next) {
      tail = tail->next;
      tail_count = 0;
      return;
    }

    uint16_t cap = head ? GROW_CAP : INITIAL_CAP;
    auto* slab = new ScheduleSlab();
    slab->items = new NodeBase*[cap];
    slab->capacity = cap;
    slab->next = nullptr;

    if (!head) {
      head = tail = slab;
    } else {
      tail->next = slab;
      tail = slab;
    }
    tail_count = 0;
  }
};

class Scheduler {
public:
  using Hook = void(*)();

  static Scheduler& instance() {
    static Scheduler s;
    return s;
  }

  void set_pre_flush(Hook h) { pre_flush_ = h; }
  void set_post_flush(Hook h) { post_flush_ = h; }
  bool has_pending() const { return list_[0].total > 0 || list_[1].total > 0; }

  NodeBase* tracking_context() const { return tracking_; }

  // RAII helper: push \`node\` as the current tracking context, restore on scope exit.
  // Used by Memo::update/Memo::get (preemptive recompute) and Effect::update so that
  // sig.get() / memo.get() calls inside compute_() attribute subscriptions to the
  // *innermost* reader, not whatever the scheduler happened to set as \`tracking_\`.
  class TrackingScope {
  public:
    explicit TrackingScope(NodeBase* node) {
      auto& s = Scheduler::instance();
      prev_ = s.tracking_;
      s.tracking_ = node;
    }
    ~TrackingScope() { Scheduler::instance().tracking_ = prev_; }
    TrackingScope(const TrackingScope&) = delete;
    TrackingScope& operator=(const TrackingScope&) = delete;
  private:
    NodeBase* prev_;
  };

  void schedule(NodeBase* node) {
    // Unconditionally enqueue. Dedup is handled by mark_dirty() (which
    // checks dirty_ before calling us) and by constructors (which only
    // call schedule once).
    uint8_t target = flushing_ ? (1 - active_) : active_;
    list_[target].append(node);
  }

  bool flush_for_budget_us(uint32_t budget_us) {
    if (list_[active_].total == 0) return true;
    if (pre_flush_) pre_flush_();
    flushing_ = true;

    ESPCOMPOSE_PERF_BEGIN();
    uint16_t total_nodes = list_[active_].total;

    static constexpr int max_passes = 10;
    const uint32_t start_us = esphome::micros();

    for (int pass = 0; pass < max_passes && list_[active_].total > 0; ++pass) {
      ESPCOMPOSE_LOGD("flush pass %d, %u nodes queued", pass, list_[active_].total);

      // Collect into contiguous scratch buffer
      uint16_t count = list_[active_].total;
      NodeBase* stack_buf[64];
      NodeBase** buf = (count <= 64) ? stack_buf : new NodeBase*[count];
      list_[active_].collect_into(buf);

      // Clear the active list (slabs are retained for reuse)
      list_[active_].clear();

      uint16_t i = 0;
      for (; i < count; ++i) {
        if (esphome::micros() - start_us >= budget_us) {
          break;
        }
        NodeBase* node = buf[i];
        if (node->is_dirty()) {
#ifdef ESPCOMPOSE_PERF
          uint32_t node_t0 = esphome::micros();
#endif
          node->update();
#ifdef ESPCOMPOSE_PERF
          uint32_t node_elapsed = esphome::micros() - node_t0;
          if (node_elapsed > 1000) {
            ESP_LOGI(ESPCOMPOSE_PERF_TAG, "  node[%u] took %" PRIu32 " \\xC2\\xB5s",
                     (unsigned)i, node_elapsed);
          }
#endif
        }
      }

      // Budget exhausted: re-schedule unprocessed nodes into incoming list
      if (i < count) {
        for (; i < count; ++i) {
          if (buf[i]->is_dirty()) {
            list_[1 - active_].append(buf[i]);
          }
        }
      }

      if (buf != stack_buf) delete[] buf;

      // Swap: incoming becomes active
      active_ = 1 - active_;
    }

#ifdef ESPCOMPOSE_PERF
    uint32_t nodes_elapsed = esphome::micros() - _perf_start_us;
#endif
    flushing_ = false;
    if (post_flush_) post_flush_();
    bool fully_drained = list_[0].total == 0 && list_[1].total == 0;
    if (!fully_drained) {
      ESPCOMPOSE_LOGW("flush incomplete: %u nodes remaining", (unsigned)(list_[0].total + list_[1].total));
    }
#ifdef ESPCOMPOSE_PERF
    uint32_t total_elapsed = esphome::micros() - _perf_start_us;
    ESP_LOGI(ESPCOMPOSE_PERF_TAG, "flush took %" PRIu32 " \\xC2\\xB5s nodes=%u drained=%s (nodes=%" PRIu32 " \\xC2\\xB5s post_flush=%" PRIu32 " \\xC2\\xB5s)",
             total_elapsed, (unsigned)total_nodes, fully_drained ? "yes" : "no",
             nodes_elapsed, total_elapsed - nodes_elapsed);
#endif
    return fully_drained;
  }

  void flush() {
    (void) flush_for_budget_us(std::numeric_limits<uint32_t>::max());
  }

private:
  Scheduler() = default;
  SlabList list_[2];
  uint8_t active_{0};
  bool flushing_{false};
  NodeBase* tracking_{nullptr};
  Hook pre_flush_{nullptr};
  Hook post_flush_{nullptr};
};

// ── mark_dirty (defined after Scheduler for inline access) ──────────────────

inline void NodeBase::mark_dirty() {
  if (dirty_) return;
  dirty_ = true;
  Scheduler::instance().schedule(this);
  for_each_subscriber([](NodeBase* sub) { sub->mark_dirty(); });
}

// ── Signal ──────────────────────────────────────────────────────────────────

template <typename T>
class Signal : public SubscribableBase {
public:
  explicit Signal(T initial = T{})
      : value_(std::move(initial)) {}

  const T& get() {
    auto* ctx = Scheduler::instance().tracking_context();
    if (ctx) add_subscriber(ctx);
    return value_;
  }

  void set(T val) {
    if (value_ != val) {
      ESPCOMPOSE_LOGD("Signal.set() changed, notifying %u subscribers", (unsigned)subscriber_count());
      value_ = std::move(val);
      for_each_subscriber([](NodeBase* sub) { sub->mark_dirty(); });
    }
  }

private:
  T value_;
};

// ── BoundSignal ─────────────────────────────────────────────────────────────
// Wraps a pointer to ESPHome global storage. Pre-bind safety: owns a local
// copy that \`ptr_\` points to until \`bind()\` retargets it.

template <typename T>
class BoundSignal : public SubscribableBase {
public:
  BoundSignal() : local_(), ptr_(&local_) {}
  explicit BoundSignal(T initial)
      : local_(std::move(initial)), ptr_(&local_) {}

  void bind(T* p) { ptr_ = p; }

  const T& get() {
    auto* ctx = Scheduler::instance().tracking_context();
    if (ctx) add_subscriber(ctx);
    return *ptr_;
  }

  T& get_mut() { return *ptr_; }

  void notify() {
    for_each_subscriber([](NodeBase* sub) { sub->mark_dirty(); });
  }

  void set(T val) {
    if (*ptr_ != val) {
      ESPCOMPOSE_LOGD("BoundSignal.set() changed, notifying %u subscribers", (unsigned)subscriber_count());
      *ptr_ = std::move(val);
      for_each_subscriber([](NodeBase* sub) { sub->mark_dirty(); });
    }
  }

private:
  T local_;
  T* ptr_;
};

// ── Memo ────────────────────────────────────────────────────────────────────

template <typename T>
class Memo : public NodeBase {
public:
  Memo(std::function<T()> compute, T initial = T{})
      : compute_(std::move(compute)),
        value_(std::move(initial)) {
    set_dirty(true);
    Scheduler::instance().schedule(this);
  }

  const T& get() {
    auto& sched = Scheduler::instance();
    auto* ctx = sched.tracking_context();
    if (ctx) add_subscriber(ctx);
    if (is_dirty()) {
      // Preemptive resolution: push *this* as tracking context so reads
      // inside compute_() subscribe to us, not to our caller.
      Scheduler::TrackingScope scope(this);
      value_ = compute_();
      set_dirty(false);
    }
    return value_;
  }

  void update() override {
    if (!is_dirty()) return;
    set_dirty(false);
    Scheduler::TrackingScope scope(this);
    T new_val = compute_();
    if (new_val != value_) {
      ESPCOMPOSE_LOGD("Memo value changed, propagating to %u subs", (unsigned)subscriber_count());
      value_ = std::move(new_val);
      for_each_subscriber([](NodeBase* sub) { sub->mark_dirty(); });
    }
  }

private:
  std::function<T()> compute_;
  T value_;
};

// ── Effect ──────────────────────────────────────────────────────────────────

class Effect : public NodeBase {
public:
  explicit Effect(std::function<void()> callback)
      : callback_(std::move(callback)) {
    set_dirty(true);
    Scheduler::instance().schedule(this);
  }

  void update() override {
    ESPCOMPOSE_LOGD("Effect executing callback");
    set_dirty(false);
    Scheduler::TrackingScope scope(this);
    callback_();
  }

private:
  std::function<void()> callback_;
};

}  // namespace espcompose
"
`;

