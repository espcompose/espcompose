  board: esp32dev
  framework:
    type: esp-idf
wifi:
  ssid: TestWifi
  password: testpass
api:
logger:
  level: DEBUG
spi:
  clk_pin: 18
  mosi_pin: 23
display:
  id: r_ref0
  platform: ili9xxx
  model: ILI9341
  invert_colors: false
  cs_pin: 5
  dc_pin: 27
  reset_pin: 33
lvgl:
  - id: r_ref1
    displays:
      - r_ref0
    pages:
      - widgets:
          - slider:
              id: r_ref2
              min_value: 0
              max_value: 255
              on_press:
                - lvgl.widget.update:
                    id: r_ref2
                    knob:
                      pad_all: 8
              on_release:
                - lvgl.widget.update:
                    id: r_ref2
                    knob:
                      pad_all: 4
          - button:
              id: r_ref3
              on_click:
                - lvgl.widget.redraw:
                    id: r_ref3
"
