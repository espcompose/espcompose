globals:
  - id: g_ref19
    type: std::string
  - id: g_ref27
    initial_value: "{0}"
    type: std::vector<int>
  - id: g_ref28
    initial_value: "{0}"
    type: std::vector<int>
  - id: g_ref29
    initial_value: "0"
    type: int
script:
  - id: scr_ref30
    parameters:
      closure_index: int
    then:
      - espcompose.animate:
          widget: r_ref18
          prop: translate_y
          from: 80
          to: 0
          duration: 300
          easing: ease_out
  - id: scr_ref31
    parameters:
      closure_index: int
    then:
      - espcompose.animate:
          widget: r_ref18
          prop: translate_y
          from: 0
          to: 80
          duration: 300
          easing: ease_in
  - id: scr_ref32
    mode: restart
    parameters:
      closure_index: int
      msg: string
    then:
      - lambda: !lambda "{ espcompose::sig_global_g_ref19.set(msg);
          espcompose::flush(); }

          { espcompose::sig_global_g_ref27.get_mut()[0] = 1;
          espcompose::sig_global_g_ref27.notify(); espcompose::flush(); }

          { espcompose::sig_global_g_ref28.get_mut()[0] = id(g_ref29);
          espcompose::sig_global_g_ref28.notify(); espcompose::flush(); }"
      - globals.set:
          id: g_ref29
          value: !lambda "return id(g_ref29) + 1;"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref32_closures[closure_index]; (void)closure;
          espcompose::sig_ovrl_ref16_mux.set(closure.__ctrl_instance_index);
          espcompose::flush(); { lv_obj_t* w = id(ovrl_ref16); for(int
          i=0;i<(int)lv_obj_get_child_count(w);i++)
          lv_obj_clear_flag(lv_obj_get_child(w,i),LV_OBJ_FLAG_HIDDEN); }"
      - delay: 0ms
      - script.execute:
          id: scr_ref30
          closure_index: 0
      - script.wait:
          id: scr_ref30
      - delay: 3s
      - script.execute:
          id: scr_ref31
          closure_index: 0
      - script.wait:
          id: scr_ref31
      - lambda: !lambda "{ espcompose::sig_global_g_ref27.get_mut()[0] = 0;
          espcompose::sig_global_g_ref27.notify(); espcompose::flush(); }

          { { lv_obj_t* w = id(ovrl_ref16); for(int
          i=0;i<(int)lv_obj_get_child_count(w);i++)
          lv_obj_add_flag(lv_obj_get_child(w,i),LV_OBJ_FLAG_HIDDEN); } }"
      - if:
          condition:
            - lambda: !lambda "return id(g_ref27)[0] == 0;"
          then:
            - globals.set:
                id: g_ref29
                value: !lambda "return 0;"
  - id: scr_ref33
    parameters:
      closure_index: int
    then:
      - script.stop:
          id: scr_ref32
      - lambda: !lambda "espcompose::sig_global_g_ref27.get_mut()[0] = 0;
          espcompose::sig_global_g_ref27.notify(); espcompose::flush();"
      - script.execute:
          id: scr_ref31
          closure_index: 0
      - script.wait:
          id: scr_ref31
      - lambda: !lambda "{ lv_obj_t* w = id(ovrl_ref16); for(int
          i=0;i<(int)lv_obj_get_child_count(w);i++)
          lv_obj_add_flag(lv_obj_get_child(w,i),LV_OBJ_FLAG_HIDDEN); }"
      - if:
          condition:
            - lambda: !lambda "return id(g_ref27)[0] == 0;"
          then:
            - globals.set:
                id: g_ref29
                value: !lambda "return 0;"
  - id: scr_ref4
    mode: restart
    parameters:
      msg: string
    then:
      - if:
          condition:
            - lambda: !lambda "return true;"
          then:
            - script.execute:
                id: scr_ref32
                closure_index: 0
                msg: !lambda "return msg;"
  - id: scr_ref12
    then:
      - script.stop:
          id: scr_ref32
      - lambda: !lambda "{ espcompose::sig_global_g_ref27.get_mut()[0] = 0;
          espcompose::sig_global_g_ref27.notify(); espcompose::flush(); }

          { { lv_obj_t* w = id(ovrl_ref16); for(int
          i=0;i<(int)lv_obj_get_child_count(w);i++)
          lv_obj_add_flag(lv_obj_get_child(w,i),LV_OBJ_FLAG_HIDDEN); } }"
      - globals.set:
          id: g_ref29
          value: !lambda "return 0;"
"
`;
