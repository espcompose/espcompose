globals:
  - id: g_ref25
    type: std::string
  - id: g_ref33
    initial_value: "{0}"
    type: std::vector<int>
  - id: g_ref34
    initial_value: "{0}"
    type: std::vector<int>
  - id: g_ref35
    initial_value: "0"
    type: int
script:
  - id: scr_ref5
    parameters:
      closure_index: int
    then:
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref5_closures[closure_index]; (void)closure;
          espcompose::sig_ovrl_ref10_mux.set(closure.__ctrl_instance_index);
          espcompose::flush(); lv_obj_clear_flag(id(ovrl_ref10),
          LV_OBJ_FLAG_HIDDEN); lv_obj_move_foreground(id(ovrl_ref10));"
  - id: scr_ref36
    parameters:
      closure_index: int
    then:
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref36_closures[closure_index]; (void)closure;
          lv_obj_add_flag(id(ovrl_ref10), LV_OBJ_FLAG_HIDDEN);"
  - id: scr_ref37
    mode: restart
    parameters:
      closure_index: int
      msg: string
    then:
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref37_closures[closure_index]; (void)closure;
          espcompose::sig_global_g_ref25.set(msg); espcompose::flush();"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref37_closures[closure_index]; (void)closure;
          espcompose::sig_global_g_ref33.get_mut()[0] = 1;
          espcompose::sig_global_g_ref33.notify(); espcompose::flush();"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref37_closures[closure_index]; (void)closure;
          espcompose::sig_global_g_ref34.get_mut()[0] = id(g_ref35);
          espcompose::sig_global_g_ref34.notify(); espcompose::flush();"
      - globals.set:
          id: g_ref35
          value: !lambda "auto& closure =
            espcompose::scr_ref37_closures[closure_index]; (void)closure;
            return id(g_ref35) + 1;"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref37_closures[closure_index]; (void)closure;
          espcompose::sig_ovrl_ref22_mux.set(closure.__ctrl_instance_index);
          espcompose::flush(); lv_obj_clear_flag(id(ovrl_ref22),
          LV_OBJ_FLAG_HIDDEN); lv_obj_move_foreground(id(ovrl_ref22));"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref37_closures[closure_index]; (void)closure;
          lv_anim_start(&espcompose::anim_3aacf9bb);"
      - delay: 3s
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref37_closures[closure_index]; (void)closure;
          lv_anim_start(&espcompose::anim_1d6a1ff3);"
      - delay: 300ms
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref37_closures[closure_index]; (void)closure;
          espcompose::sig_global_g_ref33.get_mut()[0] = 0;
          espcompose::sig_global_g_ref33.notify(); espcompose::flush();"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref37_closures[closure_index]; (void)closure;
          lv_obj_add_flag(id(ovrl_ref22), LV_OBJ_FLAG_HIDDEN);"
      - if:
          condition:
            - lambda: !lambda "auto& closure =
                espcompose::scr_ref37_closures[closure_index]; (void)closure;
                return id(g_ref33)[0] == 0;"
          then:
            - globals.set:
                id: g_ref35
                value: !lambda "auto& closure =
                  espcompose::scr_ref37_closures[closure_index];
                  (void)closure; return 0;"
  - id: scr_ref38
    parameters:
      closure_index: int
    then:
      - script.stop:
          id: scr_ref37
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref38_closures[closure_index]; (void)closure;
          espcompose::sig_global_g_ref33.get_mut()[0] = 0;
          espcompose::sig_global_g_ref33.notify(); espcompose::flush();"
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref38_closures[closure_index]; (void)closure;
          lv_anim_start(&espcompose::anim_1d6a1ff3);"
      - delay: 300ms
      - lambda: !lambda "auto& closure =
          espcompose::scr_ref38_closures[closure_index]; (void)closure;
          lv_obj_add_flag(id(ovrl_ref22), LV_OBJ_FLAG_HIDDEN);"
      - if:
          condition:
            - lambda: !lambda "auto& closure =
                espcompose::scr_ref38_closures[closure_index]; (void)closure;
                return id(g_ref33)[0] == 0;"
          then:
            - globals.set:
                id: g_ref35
                value: !lambda "auto& closure =
                  espcompose::scr_ref38_closures[closure_index];
                  (void)closure; return 0;"
  - id: scr_ref16
    mode: restart
    parameters:
      msg: string
    then:
      - if:
          condition:
            - lambda: !lambda "return true;"
          then:
            - script.execute:
                id: scr_ref37
                closure_index: 0
                msg: !lambda "return msg;"
  - id: scr_ref17
    then:
      - script.stop:
          id: scr_ref37
      - lambda: !lambda "espcompose::sig_global_g_ref33.get_mut()[0] = 0;
          espcompose::sig_global_g_ref33.notify(); espcompose::flush();"
      - lambda: !lambda "lv_obj_add_flag(id(ovrl_ref22), LV_OBJ_FLAG_HIDDEN);"
      - globals.set:
          id: g_ref35
          value: !lambda "return 0;"
"
`;
