"// Auto-generated by espcompose — do not edit
#pragma once

#include "esphome/components/espcompose/espcompose_reactive.h"
#include "esphome/components/espcompose/espcompose_runtime.h"
#include "esphome/components/espcompose/espcompose_animate.h"

namespace espcompose {

using esphome::id;
using esphome::to_string;

// ── id() result normalizer ──
// ESPHome's \`id(X)\` returns \`T&\` for LVGL widgets but \`T*\` for component
// accessors. These overloads collapse both to a uniform \`T*\`, so closure
// tables can store one normalized lookup-array element type.
template<typename T> constexpr T* _ec_id_ptr(T& v) noexcept { return &v; }
template<typename T> constexpr T* _ec_id_ptr(T* v) noexcept { return v; }

// ── Signals (one per HA entity source) ──
Signal<float> sig_ha_sensor_position;
Signal<std::string> sig_ha_sensor_position_facet_state_text;
Signal<float> sig_ha_sensor_brightness;
Signal<std::string> sig_ha_sensor_brightness_facet_state_text;

// ── Memos (derived values) ──
Memo<float> memo_0([]() -> float {
  return sig_ha_sensor_position.get();
});

Memo<float> memo_1([]() -> float {
  return sig_ha_sensor_brightness.get();
});

// ── Animate transition exec callbacks ──
static void _ec_anim_exec_translate_y(void* obj, int32_t v) {
  lv_obj_set_style_translate_y((lv_obj_t*)obj, (lv_coord_t)v, LV_PART_MAIN | LV_STATE_DEFAULT);
}
static void _ec_anim_exec_pad_top(void* obj, int32_t v) {
  lv_obj_set_style_pad_top((lv_obj_t*)obj, (lv_coord_t)v, LV_PART_MAIN | LV_STATE_DEFAULT);
}

// ── Bootstrap: wire dependency graph ──
void bootstrap_runtime() {
  auto runtime = ::espcompose::EspcomposeRuntimeComponent::get_instance();
  if (runtime == nullptr) {
    ESP_LOGE("espcompose", "Runtime component not initialized before bootstrap");
    return;
  }
  // ── Subscriber storage (exact-sized per node) ──
  static NodeBase* sig_ha_sensor_position_subs[1];
  sig_ha_sensor_position.set_subscriber_storage(sig_ha_sensor_position_subs, 1);
  static NodeBase* sig_ha_sensor_brightness_subs[1];
  sig_ha_sensor_brightness.set_subscriber_storage(sig_ha_sensor_brightness_subs, 1);
  static NodeBase* memo_0_subs[1];
  memo_0.set_subscriber_storage(memo_0_subs, 1);
  static NodeBase* memo_1_subs[1];
  memo_1.set_subscriber_storage(memo_1_subs, 1);

  // ── Widget binding effects ──
  static Effect binding_0([]() {
    { auto _target = static_cast<lv_coord_t>(memo_0.get());
      auto _cur = lv_obj_get_style_translate_y(&id(r_ref2), LV_PART_MAIN);
      if (_target < _cur) {
        lv_anim_t _a;
        lv_anim_init(&_a);
        lv_anim_set_var(&_a, &id(r_ref2));
        lv_anim_set_values(&_a, _cur, _target);
        lv_anim_set_time(&_a, 300);
        lv_anim_set_exec_cb(&_a, _ec_anim_exec_translate_y);
        lv_anim_set_path_cb(&_a, lv_anim_path_ease_out);
        lv_anim_start(&_a);
      } else {
        lv_obj_set_style_translate_y(&id(r_ref2), static_cast<lv_coord_t>(memo_0.get()), (static_cast<lv_style_selector_t>(LV_PART_MAIN) | static_cast<lv_style_selector_t>(LV_STATE_DEFAULT)));
      }
    }
  });

  static Effect binding_1([]() {
    { auto _target = static_cast<lv_coord_t>(memo_1.get());
      auto _cur = lv_obj_get_style_pad_top(&id(r_ref3), LV_PART_MAIN);
      if (_target != _cur) {
        lv_anim_t _a;
        lv_anim_init(&_a);
        lv_anim_set_var(&_a, &id(r_ref3));
        lv_anim_set_values(&_a, _cur, _target);
        lv_anim_set_time(&_a, 500);
        lv_anim_set_exec_cb(&_a, _ec_anim_exec_pad_top);
        lv_anim_set_path_cb(&_a, lv_anim_path_ease_in_out);
        lv_anim_start(&_a);
      }
    }
  });

  static NodeBase* memo_0_sources[] = {&sig_ha_sensor_position};
  memo_0.wire(memo_0_sources, 1);
  static NodeBase* memo_1_sources[] = {&sig_ha_sensor_brightness};
  memo_1.wire(memo_1_sources, 1);
  static NodeBase* binding_0_sources[] = {&memo_0};
  binding_0.wire(binding_0_sources, 1);
  static NodeBase* binding_1_sources[] = {&memo_1};
  binding_1.wire(binding_1_sources, 1);

  Scheduler::instance().schedule(&memo_0);
  Scheduler::instance().schedule(&memo_1);
  Scheduler::instance().schedule(&binding_0);
  Scheduler::instance().schedule(&binding_1);

  espcompose::flush();  // Initial flush to process dirty nodes marked during setup
}

}  // namespace espcompose"
`;

exports[`animate-transition-device > animate-transition-device > espcompose_reactive.h 1`] = `
"// espcompose_reactive.h — SolidJS-style fine-grained reactive runtime
#pragma once

#include <functional>
#include <cstdint>
#include <cstring>
#include <limits>
#include <string>

#include "esphome/core/component.h"
#include "esphome/core/hal.h"

#ifndef ESPCOMPOSE_MAX_NODES
#define ESPCOMPOSE_MAX_NODES 64
#endif

// Define ESPCOMPOSE_LOG to enable debug logging (requires esphome/core/log.h).
// Example: add -DESPCOMPOSE_LOG to build_flags in platformio_options.
#ifdef ESPCOMPOSE_LOG
#include "esphome/core/log.h"
static const char *const ESPCOMPOSE_TAG = "espcompose";
#define ESPCOMPOSE_LOGD(fmt, ...) ESP_LOGD(ESPCOMPOSE_TAG, fmt, ##__VA_ARGS__)
#define ESPCOMPOSE_LOGW(fmt, ...) ESP_LOGW(ESPCOMPOSE_TAG, fmt, ##__VA_ARGS__)
#else
#define ESPCOMPOSE_LOGD(...)
#define ESPCOMPOSE_LOGW(...)
#endif

// Define ESPCOMPOSE_PERF to enable performance timing instrumentation.
// Example: add -DESPCOMPOSE_PERF to build_flags (done automatically by --perf).
#ifdef ESPCOMPOSE_PERF
#include "esphome/core/log.h"
static const char *const ESPCOMPOSE_PERF_TAG = "ec_perf";
#define ESPCOMPOSE_PERF_BEGIN() uint32_t _perf_start_us = esphome::micros()
#define ESPCOMPOSE_PERF_END(label, fmt, ...) \\
  ESP_LOGI(ESPCOMPOSE_PERF_TAG, label " took %" PRIu32 " \\xC2\\xB5s" fmt, esphome::micros() - _perf_start_us, ##__VA_ARGS__)
#else
#define ESPCOMPOSE_PERF_BEGIN()
#define ESPCOMPOSE_PERF_END(label, ...)
#endif

namespace espcompose {

class Scheduler;

class NodeBase {
public:
  NodeBase(uint8_t order) : order_(order) {}
  virtual ~NodeBase() = default;

  void mark_dirty();
  virtual void update() {}

  bool is_dirty() const { return dirty_; }
  void set_dirty(bool d) { dirty_ = d; }

  NodeBase** subscribers() { return subscribers_; }
  uint16_t subscriber_count() const { return subscriber_count_; }

  void set_subscriber_storage(NodeBase** buf, uint16_t capacity) {
    subscribers_ = buf;
    subscriber_capacity_ = capacity;
  }

  void add_subscriber(NodeBase* sub) {
    if (subscribers_ && subscriber_count_ < subscriber_capacity_) {
      subscribers_[subscriber_count_++] = sub;
    } else {
      ESPCOMPOSE_LOGW("subscriber overflow! capacity=%u", (unsigned)subscriber_capacity_);
    }
  }

  void set_sources(NodeBase** sources, uint8_t count) {
    sources_ = sources;
    source_count_ = count;
  }

  uint8_t order() const { return order_; }

private:
  bool dirty_{false};
  uint8_t order_{0};

  NodeBase** subscribers_{nullptr};
  uint16_t subscriber_count_{0};
  uint16_t subscriber_capacity_{0};

  NodeBase** sources_{nullptr};
  uint8_t source_count_{0};
};

class Scheduler {
public:
  using Hook = void(*)();

  static Scheduler& instance() {
    static Scheduler s;
    return s;
  }

  void set_pre_flush(Hook h) { pre_flush_ = h; }
  void set_post_flush(Hook h) { post_flush_ = h; }
  bool has_pending() const { return count_[0] > 0 || count_[1] > 0; }

  void schedule(NodeBase* node) {
    // While flushing, newly dirtied nodes go to the incoming buffer.
    // Otherwise they go to the active buffer for the next flush.
    uint8_t target = flushing_ ? (1 - active_) : active_;
    if (count_[target] >= ESPCOMPOSE_MAX_NODES) return;
    for (uint16_t i = 0; i < count_[target]; ++i) {
      if (buf_[target][i] == node) return;
    }
    buf_[target][count_[target]++] = node;
  }

  bool flush_for_budget_us(uint32_t budget_us) {
    if (count_[active_] == 0) return true;
    if (pre_flush_) pre_flush_();
    flushing_ = true;

    ESPCOMPOSE_PERF_BEGIN();
    uint16_t total_nodes = count_[active_];

    static constexpr int max_passes = 10;
    const uint32_t start_us = esphome::micros();

    for (int pass = 0; pass < max_passes && count_[active_] > 0; ++pass) {
      ESPCOMPOSE_LOGD("flush pass %d, %u nodes queued", pass, count_[active_]);

      // Insertion-sort the active buffer by topological order
      for (uint16_t i = 1; i < count_[active_]; ++i) {
        NodeBase* key = buf_[active_][i];
        int j = static_cast<int>(i) - 1;
        while (j >= 0 && buf_[active_][j]->order() > key->order()) {
          buf_[active_][j + 1] = buf_[active_][j];
          --j;
        }
        buf_[active_][j + 1] = key;
      }

      uint16_t count = count_[active_];
      uint16_t i = 0;
      for (; i < count; ++i) {
        if (esphome::micros() - start_us >= budget_us) {
          break;
        }
        NodeBase* node = buf_[active_][i];
        if (node->is_dirty()) {
#ifdef ESPCOMPOSE_PERF
          uint32_t node_t0 = esphome::micros();
#endif
          node->update();
          node->set_dirty(false);
#ifdef ESPCOMPOSE_PERF
          uint32_t node_elapsed = esphome::micros() - node_t0;
          if (node_elapsed > 1000) {
            ESP_LOGI(ESPCOMPOSE_PERF_TAG, "  node[%u] order=%u took %" PRIu32 " \\xC2\\xB5s",
                     (unsigned)i, (unsigned)node->order(), node_elapsed);
          }
#endif
        }
      }

      // Budget exhausted: move unprocessed nodes to the incoming buffer.
      if (i < count) {
        uint8_t incoming = 1 - active_;
        for (; i < count; ++i) {
          schedule(buf_[active_][i]);
        }
      }

      // Swap: incoming becomes active, old active is cleared.
      count_[active_] = 0;
      active_ = 1 - active_;
    }

#ifdef ESPCOMPOSE_PERF
    uint32_t nodes_elapsed = esphome::micros() - _perf_start_us;
#endif
    flushing_ = false;
    if (post_flush_) post_flush_();
    bool fully_drained = count_[0] == 0 && count_[1] == 0;
#ifdef ESPCOMPOSE_PERF
    uint32_t total_elapsed = esphome::micros() - _perf_start_us;
    ESP_LOGI(ESPCOMPOSE_PERF_TAG, "flush took %" PRIu32 " \\xC2\\xB5s nodes=%u drained=%s (nodes=%" PRIu32 " \\xC2\\xB5s post_flush=%" PRIu32 " \\xC2\\xB5s)",
             total_elapsed, (unsigned)total_nodes, fully_drained ? "yes" : "no",
             nodes_elapsed, total_elapsed - nodes_elapsed);
#endif
    return fully_drained;
  }

  void flush() {
    (void) flush_for_budget_us(std::numeric_limits<uint32_t>::max());
  }

private:
  Scheduler() = default;
  NodeBase* buf_[2][ESPCOMPOSE_MAX_NODES]{};
  uint16_t count_[2]{0, 0};
  uint8_t active_{0};
  bool flushing_{false};
  Hook pre_flush_{nullptr};
  Hook post_flush_{nullptr};
};

inline void NodeBase::mark_dirty() {
  if (dirty_) return;
  dirty_ = true;
  Scheduler::instance().schedule(this);
  for (uint16_t i = 0; i < subscriber_count_; ++i) {
    subscribers_[i]->mark_dirty();
  }
}

template <typename T>
class Signal : public NodeBase {
public:
  explicit Signal(T initial = T{})
      : NodeBase(0), value_(std::move(initial)) {}

  const T& get() const { return value_; }

  void set(T val) {
    if (value_ != val) {
      ESPCOMPOSE_LOGD("Signal.set() changed, notifying %u subscribers", (unsigned)subscriber_count());
      value_ = std::move(val);
      for (uint16_t i = 0; i < subscriber_count(); ++i) {
        subscribers()[i]->mark_dirty();
      }
    }
  }

private:
  T value_;
};

/**
 * BoundSignal<T> — a reactive node that wraps a pointer to external storage.
 *
 * Used for ESPHome globals: the GlobalsComponent<T> owns the value, and
 * BoundSignal points at it. Reads and writes go through the pointer,
 * avoiding value duplication. The pointer is set via bind() during
 * bootstrap_runtime(), after ESPHome's setup has restored preferences.
 *
 * Pre-bind safety: BoundSignal owns a local copy of the initial value (passed
 * via the constructor and matching the ESPHome global's \`initial_value\`) and
 * \`ptr_\` points to that local copy until bind() retargets it. This makes
 * \`get()\` safe to call during inline widget construction in main.cpp's setup()
 * function, which runs before bootstrap_runtime().
 */
template <typename T>
class BoundSignal : public NodeBase {
public:
  BoundSignal() : NodeBase(0), local_(), ptr_(&local_) {}
  explicit BoundSignal(T initial)
      : NodeBase(0), local_(std::move(initial)), ptr_(&local_) {}

  void bind(T* p) { ptr_ = p; }

  const T& get() const { return *ptr_; }

  /** Mutable reference — for in-place mutation (e.g. vector element assignment). */
  T& get_mut() { return *ptr_; }

  /** Manually notify subscribers after in-place mutation via get_mut(). */
  void notify() {
    for (uint16_t i = 0; i < subscriber_count(); ++i) {
      subscribers()[i]->mark_dirty();
    }
  }

  void set(T val) {
    if (*ptr_ != val) {
      ESPCOMPOSE_LOGD("BoundSignal.set() changed, notifying %u subscribers", (unsigned)subscriber_count());
      *ptr_ = std::move(val);
      for (uint16_t i = 0; i < subscriber_count(); ++i) {
        subscribers()[i]->mark_dirty();
      }
    }
  }

private:
  T local_;
  T* ptr_;
};

template <typename T>
class Memo : public NodeBase {
public:
  Memo(std::function<T()> compute, T initial = T{})
      : NodeBase(1),
        compute_(std::move(compute)),
        value_(std::move(initial)) {
    set_dirty(true);
  }

  const T& get() {
    if (is_dirty()) {
      value_ = compute_();
      set_dirty(false);
    }
    return value_;
  }

  void update() override {
    T new_val = compute_();
    if (new_val != value_) {
      ESPCOMPOSE_LOGD("Memo value changed, propagating to %u subs", (unsigned)subscriber_count());
      value_ = std::move(new_val);
      for (uint16_t i = 0; i < subscriber_count(); ++i) {
        subscribers()[i]->mark_dirty();
      }
    }
  }

  void wire(NodeBase** sources, uint8_t count) {
    set_sources(sources, count);
    for (uint8_t i = 0; i < count; ++i) {
      sources[i]->add_subscriber(this);
    }
  }

private:
  std::function<T()> compute_;
  T value_;
};

class Effect : public NodeBase {
public:
  explicit Effect(std::function<void()> callback)
      : NodeBase(255), callback_(std::move(callback)) {
    set_dirty(true);
  }

  void update() override {
    ESPCOMPOSE_LOGD("Effect executing callback");
    callback_();
  }

  void wire(NodeBase** sources, uint8_t count) {
    set_sources(sources, count);
    for (uint8_t i = 0; i < count; ++i) {
      sources[i]->add_subscriber(this);
    }
  }

private:
  std::function<void()> callback_;
};

}  // namespace espcompose
"
`;

exports[`animate-transition-device > animate-transition-device 1`] = `
"esphome:
  name: animate-transition-device
  includes:
    - espcompose_bindings.h
  platformio_options:
    build_flags:
      - -DESPCOMPOSE_MAX_NODES=24
esp32:
  board: esp32dev
  framework:
    type: esp-idf
wifi:
  ssid: TestWifi
  password: testpass
api:
logger:
  level: DEBUG
spi:
  clk_pin: 18
  mosi_pin: 23
display:
  id: r_ref0
  platform: ili9xxx
  model: ILI9341
  invert_colors: false
  cs_pin: 5
  dc_pin: 27
  reset_pin: 33
lvgl:
  - id: r_ref1
    displays:
      - r_ref0
    pages:
      - pad_all: 16
        layout:
          type: flex
          flex_flow: COLUMN
          pad_row: 16
        widgets:
          - obj:
              id: r_ref2
              width: 100%
              height: 80
              bg_color: "0x4CAF50"
              translate_y: !lambda "return espcompose::memo_0.get();"
              widgets:
                - label:
                    text: Decrease Only
                    align: CENTER
          - obj:
              id: r_ref3
              width: 100%
              height: 80
              bg_color: "0x2196F3"
              pad_top: !lambda "return espcompose::memo_1.get();"
              widgets:
                - label:
                    text: Always Animate
                    align: CENTER
                    text_color: "0xFFFFFF"
sensor:
  - platform: homeassistant
    id: ha_sensor_position
    entity_id: sensor.position
    on_value:
      - lambda: !lambda "espcompose::sig_ha_sensor_position.set(x); espcompose::flush();"
  - platform: homeassistant
    id: ha_sensor_brightness
    entity_id: sensor.brightness
    on_value:
      - lambda: !lambda "espcompose::sig_ha_sensor_brightness.set(x); espcompose::flush();"
text_sensor:
  - platform: homeassistant
    id: ha_sensor_position_facet_state_text
    entity_id: sensor.position
    on_value:
      - lambda: !lambda "espcompose::sig_ha_sensor_position_facet_state_text.set(x);
          espcompose::flush();"
  - platform: homeassistant
    id: ha_sensor_brightness_facet_state_text
    entity_id: sensor.brightness
    on_value:
      - lambda: !lambda "espcompose::sig_ha_sensor_brightness_facet_state_text.set(x);
          espcompose::flush();"
external_components:
  - source:
      type: local
      path: ./external_components
    components:
      - espcompose
espcompose:
  flush_budget_us: 10000
"
`;
