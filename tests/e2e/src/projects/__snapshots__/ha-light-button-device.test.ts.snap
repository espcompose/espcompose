binary_sensor:
  - platform: homeassistant
    id: ha_light_kitchen
    entity_id: light.kitchen
    trigger_on_initial_state: true
    on_state:
      - lambda: !lambda "espcompose::sig_ha_light_kitchen.set(x); espcompose::flush();"
  - platform: homeassistant
    id: ha_light_bedroom
    entity_id: light.bedroom
    trigger_on_initial_state: true
    on_state:
      - lambda: !lambda "espcompose::sig_ha_light_bedroom.set(x); espcompose::flush();"
sensor:
  - platform: homeassistant
    id: ha_light_kitchen_attr_brightness
    entity_id: light.kitchen
    attribute: brightness
    on_value:
      - lambda: !lambda "espcompose::sig_ha_light_kitchen_attr_brightness.set(x);
          espcompose::flush();"
  - platform: homeassistant
    id: ha_light_bedroom_attr_brightness
    entity_id: light.bedroom
    attribute: brightness
    on_value:
      - lambda: !lambda "espcompose::sig_ha_light_bedroom_attr_brightness.set(x);
          espcompose::flush();"
text_sensor:
