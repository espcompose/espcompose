namespace espcompose {

using esphome::id;
using esphome::to_string;

// ── id() result normalizer ──
// ESPHome's \`id(X)\` returns \`T&\` for LVGL widgets but \`T*\` for component
// accessors. These overloads collapse both to a uniform \`T*\`, so closure
// tables can store one normalized lookup-array element type.
template<typename T> constexpr T* _ec_id_ptr(T& v) noexcept { return &v; }
template<typename T> constexpr T* _ec_id_ptr(T* v) noexcept { return v; }

// ── Script closure tables ──
static decltype(_ec_id_ptr(id(r_ref3))) const ec_scr_ref6_lights[] = {
  _ec_id_ptr(id(r_ref3))
};
struct scr_ref6_closure_t {
  int light_idx;
};
static const scr_ref6_closure_t scr_ref6_closures[] = {
  { 0 }
};

